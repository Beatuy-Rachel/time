# 镜像配置
IMAGE=ghcr.io/beatuy-rachel/time
IMAGE_TAG=latest

# 服务器对外端口，容器内部使用 8080 端口
HOST_PORT=8080

# 必须修改为随机长字符串，用于签发登录令牌
AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL 数据持久化目录
POSTGRES_DB=time_record
POSTGRES_USER=time_record
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DATA_VOLUME=./postgres-data

# 健康检查最长等待时间（秒）
DEPLOY_WAIT_TIMEOUT=120

# 如果 GHCR 镜像是私有的，取消注释并填写。
# 不要把真实 Token 提交到 GitHub。
# GHCR_USERNAME=Beatuy-Rachel
# GHCR_TOKEN=your-read-packages-token
